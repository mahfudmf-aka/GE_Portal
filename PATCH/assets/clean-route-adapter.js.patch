+  function toClean(href){
    if(!href) return href;
    if(/^(?:https?:|mailto:|tel:|javascript:)/i.test(href)) return href;
    var hash='';
    var hi=href.indexOf('#');
    if(hi>=0){hash=href.slice(hi);href=href.slice(0,hi);}
    var m=href.match(/(?:^|\/)([^\/?#]+)\.html(?:\?([^#]*))?/);
    if(!m || m[1]==='login' || m[1]==='change-password') return href+hash;
    var route=m[1].toLowerCase(), q=m[2]||'';
    route=(window.P40_CLEAN_ALIASES||{})[route]||route;
    // E1 aliases are implementation names, not Clean page identities.
    route=route.replace(/^e1-/,'');
    var parts=route.split('?'); route=parts[0];
    var params=new URLSearchParams(parts[1]||'');
    new URLSearchParams(q).forEach((v,k)=>params.set(k,v));
    params.set('page',route);
    var out='app.html?'+params.toString();
    return out+hash;
  }
